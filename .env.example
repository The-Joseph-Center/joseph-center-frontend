VITE_SANITY_PROJECT_ID=
VITE_SANITY_DATASET=
VITE_SIMPLE_ANALYTICS_ID=

# Resend (form notification emails)
RESEND_API_KEY=
# Staff recipients — comma-separated supported, blank = no notification sent
CONTACT_TO_EMAIL=                      # template 9: contact form → jc@ inbox
STAFF_DONATION_TO_EMAIL=               # template 6: new donation → Mona + finance
STAFF_VOLUNTEER_TO_EMAIL=              # template 7: new volunteer → Shawna
CONTACT_FROM_EMAIL=                    # From: address used by submit-contact / submit-volunteer
                                       # (Resend requires verified domain; falls back to onboarding@resend.dev)

# Sanity Write (sync functions)
SANITY_WRITE_TOKEN=

# Turso (form submissions, event registrations, donations)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# AWeber (newsletter)
AWEBER_CLIENT_ID=
AWEBER_CLIENT_SECRET=
AWEBER_ACCOUNT_ID=
AWEBER_LIST_ID=

# Stripe (Phase 2 — donations)
# Server-side keys (Netlify Functions only — never expose):
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Client-side publishable key — required for embedded Stripe Elements:
VITE_STRIPE_PUBLISHABLE_KEY=

# Donations
DONATION_FROM_EMAIL=                   # used by the Stripe webhook for confirmation emails (defaults to onboarding@resend.dev)

# YouTube (Coffee Chat sync)
YOUTUBE_API_KEY=
COFFEE_CHAT_PLAYLIST_ID=

# Netlify deploy control (manual "Deploy Site" button in Studio).
# Server-side — used by netlify/functions/trigger-deploy.ts:
NETLIFY_DEPLOY_HOOK_URL=
DEPLOY_HOOK_SECRET=
# The Studio uses SANITY_STUDIO_DEPLOY_HOOK_SECRET (same value as
# DEPLOY_HOOK_SECRET) and SANITY_STUDIO_DEPLOY_FUNCTION_URL. Configure those
# in studio/.env or in the Studio's hosting environment.
